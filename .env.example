# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า
# true = ใช้ข้อมูลจำลอง (ไม่ต้องมี MQTT/API)  false = ใช้ข้อมูลจริง
VITE_USE_MOCK=true
VITE_RACK_ID=rack-a12
# MQTT ต้องเปิด WebSocket ที่ Broker (เช่น Mosquitto listener 9001 protocol websockets)
VITE_MQTT_URL=ws://localhost:9001
# REST API ที่ดึงข้อมูลย้อนหลังจาก Time-Series Database
VITE_API_BASE=http://localhost:8000/api
